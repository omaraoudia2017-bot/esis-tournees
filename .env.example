# Copier ce fichier en .env puis remplacer les valeurs "a_generer".
# Le fichier .env n'est JAMAIS versionné (voir .gitignore).

ENVIRONMENT=dev

# --- PostgreSQL ---
POSTGRES_USER=esis
POSTGRES_PASSWORD=a_generer
POSTGRES_DB=esis
POSTGRES_PORT=5432

# --- Sécurité ---
# Clé Fernet (chiffrement des digicodes, téléphones, notes, secrets TOTP)
FERNET_KEY=a_generer
# Secret de signature des JWT
JWT_SECRET_KEY=a_generer
JWT_EXPIRE_MINUTES=30
