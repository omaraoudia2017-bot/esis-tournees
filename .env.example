# Copier ce fichier en .env puis remplacer les valeurs "a_generer".
# Le fichier .env n'est JAMAIS versionné (voir .gitignore).

ENVIRONMENT=dev
# Fuseau horaire : « tournée du jour » et heures de passage prévues
FUSEAU_HORAIRE=Europe/Paris

# --- PostgreSQL ---
POSTGRES_USER=esis
POSTGRES_PASSWORD=a_generer
POSTGRES_DB=esis
POSTGRES_PORT=5432

# --- Sécurité ---
# Clé Fernet (chiffrement des digicodes, téléphones, notes, secrets TOTP)
FERNET_KEY=a_generer
# Secret de signature des JWT
JWT_SECRET_KEY=a_generer
JWT_EXPIRE_MINUTES=30

# --- Géocodage (Nominatim / OpenStreetMap) ---
# Identifie l'application auprès du service (politique d'usage Nominatim)
NOMINATIM_USER_AGENT=esis-tournees/0.2 (projet etudiant ESIS)

# --- Optimisation des tournées ---
# Coordonnées GPS de l'entrepôt de départ (par défaut : Lyon centre)
DEPOT_NOM=Depot
DEPOT_LATITUDE=45.7578
DEPOT_LONGITUDE=4.8320
COEFFICIENT_ROUTIER=1.3
VITESSE_MOYENNE_KMH=30
OPTIM_TEMPS_LIMITE_S=5
HEURE_DEBUT_TOURNEE=07:00
HEURE_FIN_TOURNEE=22:00
TEMPS_SERVICE_NORMAL_MIN=10
TEMPS_SERVICE_HAYON_MIN=20
PERIODE_MATIN=07:00-14:00
PERIODE_APRES_MIDI=13:00-19:00
PERIODE_SOIREE=17:00-22:00
BASCULE_APRES_MIDI=13:00
BASCULE_SOIREE=18:00
COUT_FIXE_VEHICULE_S=3600
OPTIM_BUDGET_TOTAL_S=9
